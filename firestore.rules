rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================
    // SafeSite — Firestore Security Rules
    // ============================================

    // ---- Users Collection ----
    match /users/{userId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // ---- Daily Reports Collection ----
    match /dailyReports/{reportId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // ---- Safety Incidents Collection ----
    match /safetyIncidents/{incidentId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // ---- Sites Collection ----
    match /sites/{siteId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // ---- Catch-all ----
    match /{document=**} {
      allow read, write: if true;
    }
  }
}

